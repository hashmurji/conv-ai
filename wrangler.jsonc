{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conv-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // privacy.html and terms.html are served at /privacy and /terms, without a trailing slash.
    // /privacy/ and /terms/ are permanent redirects in public/_redirects.
    "html_handling": "auto-trailing-slash",
    // The Worker handles the contact API, and /404 so that URL is not a 200 copy of the not-found page.
    "run_worker_first": ["/api/*", "/404", "/404/", "/404.html"]
  },
  "vars": {
    "EMAIL_FROM": "Conv-AI <hello@conv-ai.co.uk>",
    "EMAIL_NOTIFY": "hello@conv-ai.co.uk",
    "SITE_URL": "https://conv-ai.co.uk",
    "COMPANY_OFFICE": "Carlyle House, 78 Chorley New Road, Bolton, Greater Manchester, BL1 4BY"
  },
  "observability": { "enabled": true }
}
