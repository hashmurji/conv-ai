{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conv-ai-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker; every other request is served straight from ./public
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EMAIL_FROM": "Conv-AI <hello@conv-ai.co.uk>",
    "EMAIL_NOTIFY": "hello@conv-ai.co.uk",
    "SITE_URL": "https://conv-ai.co.uk",
    "COMPANY_OFFICE": "Carlyle House, 78 Chorley New Road, Bolton, Greater Manchester, BL1 4BY"
  },
  "observability": { "enabled": true }
}
